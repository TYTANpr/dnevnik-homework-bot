# Токен бота от @BotFather
TG_BOT_TOKEN=1234567890:AAF...
# ID чата/группы класса (например -1001234567890)
TG_CHAT_ID=-1001234567890
# (Необязательно) ID топика/ветки, если в группе включены темы
TG_TOPIC_ID=
# (Необязательно) Твой личный TG ID — сюда бот напишет, если протухнет токен дневника
TG_ADMIN_ID=

# Твой education_id (видно в URL: p_educations[]=176385)
EDUCATION_ID=176385
# Кука X-JWT-Token из браузера
DNEVNIK_JWT_TOKEN=вставь_сюда_токен

# Нужные предметы через запятую
TARGET_SUBJECTS=Алгебра,Геометрия,Вероятность и статистика

# За сколько дней вперёд проверять ДЗ (и 1 день назад на случай опоздавших правок)
LOOKAHEAD_DAYS=7
# Пауза между проверками в минутах (если запускать в режиме --loop)
CHECK_INTERVAL_MINUTES=60
